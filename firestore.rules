rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scans/{scanId} {
      // Allow read/update if user is authenticated and matches user_id field
      // OR allow read/write for now as a fallback to verify frontend connection
      allow read, write: if request.auth != null;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
